    <style>
        /* --- GLOBAL STYLES --- */
        :root {
            --bg-color: #f4f4f4;
            --card-bg: #ffffff;
            --text-color: #111;
            --border-color: #000;
            --font-serif: 'Playfair Display', serif;
            --font-sans: 'Lato', sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-color);
            font-family: var(--font-sans);
            color: var(--text-color);
            display: flex;
            justify-content: center;
            padding: 20px;
            line-height: 1.6;
        }

        /* --- MAIN CONTAINER --- */
        .container {
            background-color: var(--card-bg);
            width: 100%;
            max-width: 900px;
            padding: 40px 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            min-height: 80vh;
            position: relative;
        }

        /* --- TYPOGRAPHY --- */
        h1 {
            font-family: var(--font-serif);
            font-size: 3.5rem;
            text-align: center;
            letter-spacing: 4px;
            margin-bottom: 10px;
            font-weight: 400;
            text-transform: uppercase;
        }

        h2 {
            font-family: var(--font-serif);
            font-size: 2.2rem;
            text-align: center;
            letter-spacing: 2px;
            margin-bottom: 15px;
            font-weight: 400;
            text-transform: uppercase;
        }

        h3 {
            font-family: var(--font-serif);
            font-size: 1.5rem;
            margin-bottom: 10px;
            text-align: left;
        }

        p.subtitle {
            text-align: center;
            font-family: var(--font-serif);
            font-size: 1.1rem;
            margin-bottom: 30px;
            color: #333;
            line-height: 1.5;
        }

        /* --- SOCIAL ICONS & TOOLTIPS --- */
        .social-icons {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 30px;
        }

        .social-icons a, .social-icons .comic-icon {
            color: var(--text-color);
            font-size: 1.5rem;
            transition: transform 0.2s, opacity 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            position: relative;
        }

        .social-icons a:hover, .social-icons .comic-icon:hover {
            transform: translateY(-3px);
            opacity: 0.7;
        }

        .icon-svg {
            width: 28px;
            height: 28px;
            fill: currentColor;
        }

        /* Hover Tooltip Text */
        .tooltip-text {
            position: absolute;
            bottom: -20px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.7rem;
            color: #888;
            white-space: nowrap;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s;
            font-family: var(--font-sans);
            text-transform: capitalize;
        }

        .social-icons a:hover .tooltip-text,
        .social-icons .comic-icon:hover .tooltip-text {
            opacity: 1;
        }

        /* Specific styling for the Comic Bunny Icon */
        .comic-icon {
            cursor: pointer;
        }
        
        .comic-icon svg {
            width: 28px;
            height: 28px;
            fill: currentColor;
        }

        /* --- BUTTONS --- */
        .main-buttons {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-top: 20px;
        }

        .btn {
            display: block;
            width: 100%;
            padding: 15px;
            text-align: center;
            text-decoration: none;
            color: var(--text-color);
            border: 1px solid var(--border-color);
            font-size: 1.1rem;
            font-family: var(--font-serif);
            transition: background 0.3s, color 0.3s;
            cursor: pointer;
            background: transparent;
        }

        .btn:hover {
            background-color: var(--border-color);
            color: #fff;
        }

        /* --- GALLERY GENERAL --- */
        .gallery-section {
            margin-bottom: 40px;
        }

        .section-title {
            font-family: var(--font-serif);
            font-size: 1.5rem;
            text-align: center;
            margin-bottom: 15px;
            border-bottom: 1px solid #ddd;
            padding-bottom: 10px;
        }

        /* Featured Slideshow */
        .slideshow-container {
            position: relative;
            max-width: 100%;
            margin: 20px auto;
            overflow: hidden;
            border: 1px solid #ddd;
            cursor: pointer;
            background: #f9f9f9;
        }

        .slide {
            display: none;
            width: 100%;
        }

        .slide img {
            width: 100%;
            height: auto;
            display: block;
            object-fit: contain;
            max-height: 600px;
        }

        .slide.active {
            display: block;
            animation: fade 1.5s ease-in-out;
        }

        @keyframes fade {
            from { opacity: 0.4; }
            to { opacity: 1; }
        }

        /* Video Sized Containers (for bust, half, full) */
        .video-container {
            position: relative;
            width: 100%;
            margin-bottom: 20px;
            background: #eee;
            border: 1px solid #ddd;
            cursor: pointer;
            overflow: hidden;
        }

        .video-container img {
            width: 100%;
            height: auto;
            display: block;
            object-fit: contain;
        }

        /* Standard Grid — natural sizes, no forced height */
        .grid-gallery {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 10px;
        }

        .grid-gallery img {
            width: 100%;
            height: auto;
            object-fit: contain;
            border: 1px solid #ddd;
            cursor: pointer;
            transition: transform 0.2s;
            display: block;
        }

        .grid-gallery img:hover {
            transform: scale(1.03);
        }

        /* --- NSFW / GORE SECTION --- */
        .nsfw-gallery {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
            margin-top: 15px;
        }

        .nsfw-gallery img {
            width: 100%;
            height: 100px;
            object-fit: cover;
            border: 1px solid #ddd;
            border-radius: 4px;
            cursor: pointer;
            transition: transform 0.2s, filter 0.3s;
            filter: blur(10px);
        }

        .nsfw-gallery img.unblurred {
            filter: blur(0px);
        }

        .nsfw-gallery img:hover {
            transform: scale(1.05);
        }

        /* --- LIGHTBOX (ZOOM) --- */
        .lightbox {
            display: none;
            position: fixed;
            z-index: 9999;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.95);
            justify-content: center;
            align-items: center;
            flex-direction: column;
            padding: 20px;
        }

        .lightbox.active {
            display: flex;
        }

        .lightbox img {
            max-width: 95%;
            max-height: 80vh;
            object-fit: contain;
            border: 2px solid #fff;
        }

        .lightbox-close {
            margin-top: 20px;
            padding: 10px 30px;
            background: #fff;
            color: #000;
            border: none;
            font-size: 1rem;
            cursor: pointer;
            font-family: var(--font-sans);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .lightbox-close:hover {
            background: #ccc;
        }

        /* --- COMMISSION PAGE --- */
        .commission-text {
            font-size: 0.95rem;
            margin-bottom: 25px;
        }

        .commission-list {
            list-style-type: none;
            padding-left: 0;
            margin-bottom: 20px;
        }

        .commission-list li {
            margin-bottom: 8px;
            padding-left: 15px;
            position: relative;
        }

        .commission-list li::before {
            content: "•";
            position: absolute;
            left: 0;
            font-weight: bold;
        }

        /* Form Styles */
        .form-group {
            margin-bottom: 20px;
            text-align: left;
        }

        .form-group label {
            display: block;
            font-weight: bold;
            margin-bottom: 8px;
            font-family: var(--font-serif);
        }

        .form-group select, 
        .form-group input, 
        .form-group textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            font-family: var(--font-sans);
            font-size: 1rem;
            background: #fff;
        }

        .form-group textarea {
            resize: vertical;
            min-height: 120px;
        }

        /* Small, italic notes */
        .small-italic {
            font-size: 0.8rem;
            font-style: italic;
            color: #555;
        }

        /* Price Calculator Box — REMOVED, not shown on site */
        /* Hide the old estimator if any remains */
        .price-estimator {
            display: none;
        }

        /* Back Button */
        .back-btn {
            display: inline-block;
            margin-top: 20px;
            text-decoration: none;
            color: #666;
            font-size: 0.9rem;
            cursor: pointer;
            border: none;
            background: none;
            font-family: var(--font-sans);
        }

        .back-btn:hover {
            color: #000;
            text-decoration: underline;
        }

        /* Hide pages by default */
        .page {
            display: none;
        }

        .page.active {
            display: block;
        }

        .divider {
            border: 0;
            border-top: 1px solid #ddd;
            margin: 30px 0;
        }

        /* Custom checkbox row */
        .checkbox-row {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 5px;
        }

        .checkbox-row label {
            font-weight: normal;
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
        }

        .checkbox-row input[type="checkbox"] {
            width: auto;
            transform: scale(1.2);
            margin: 0;
        }

        /* File input */
        input[type="file"] {
            padding: 8px;
            background: #f9f9f9;
        }

        /* --- VISITOR COUNTER --- */
        #visitor-counter {
            position: fixed;
            bottom: 15px;
            right: 20px;
            font-size: 0.7rem;
            color: #888;
            font-family: var(--font-sans);
            z-index: 9999;
            background: rgba(255, 255, 255, 0.8);
            padding: 4px 8px;
            border-radius: 4px;
            pointer-events: none;
        }

        /* remove request form outside container — already handled by structure */
    </style>
</head>
