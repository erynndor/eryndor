<script>
    // --- PAGE NAVIGATION ---
    function showPage(pageId) {
        document.querySelectorAll('.page').forEach(page => {
            page.classList.remove('active');
        });
        document.getElementById(pageId).classList.add('active');
        window.scrollTo(0, 0);
    }

    // --- SLIDESHOW ---
    let slideIndex = 0;
    let slideInterval;

    function showSlides() {
        let slides = document.querySelectorAll(".slide");
        if (slides.length === 0) return;
        for (let i = 0; i < slides.length; i++) {
            slides[i].classList.remove("active");
        }
        slideIndex++;
        if (slideIndex > slides.length) { slideIndex = 1 }
        slides[slideIndex - 1].classList.add("active");
    }

    function initSlideshow() {
        let slides = document.querySelectorAll(".slide");
        if (slides.length > 0) {
            slides[0].classList.add("active");
            slideIndex = 1;
            slideInterval = setInterval(showSlides, 5000);
        }
    }

    // --- LIGHTBOX ---
    function openLightbox(src) {
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightboxImg');
        lightboxImg.src = src;
        lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function closeLightbox(event) {
        if (event.target.id === 'lightbox' || event.target.classList.contains('lightbox-close')) {
            const lightbox = document.getElementById('lightbox');
            lightbox.classList.remove('active');
            document.body.style.overflow = 'auto';
        }
    }

    // --- NSFW BLUR + ZOOM LOGIC ---
    function handleNsfwClick(img, event) {
        event.stopPropagation(); // prevent triggering lightbox from container

        if (!img.classList.contains('unblurred')) {
            // First click: unblur
            img.classList.add('unblurred');
            img.style.filter = 'blur(0px)';
        } else {
            // Second click: enlarge via lightbox
            openLightbox(img.src);
        }
    }

    // --- PRICE CALCULATION (hidden from UI, only used for hidden input) ---
    function updateHiddenTotal() {
        // Base price
        const baseTypeSelect = document.getElementById('baseType');
        const basePrice = parseFloat(baseTypeSelect.options[baseTypeSelect.selectedIndex].getAttribute('data-price'));
        
        // Finish multiplier
        const finishSelect = document.getElementById('finishType');
        const finishMultiplier = parseFloat(finishSelect.options[finishSelect.selectedIndex].getAttribute('data-price'));
        
        // Background multiplier (as decimal)
        const bgSelect = document.getElementById('bgType');
        const bgMultiplier = parseFloat(bgSelect.options[bgSelect.selectedIndex].getAttribute('data-price')) / 100;
        
        // Add-ons
        const addChar = document.getElementById('addChar').checked ? 0.5 : 0;
        const addGore = document.getElementById('addGore').checked ? 0.5 : 0;
        const addNsfw = document.getElementById('addNsfw').checked ? 0.5 : 0;
        const addCommercial = document.getElementById('addCommercial').checked ? 0.5 : 0;
        const addMerch = document.getElementById('addMerch').checked ? 1.0 : 0;
        const totalAddons = addChar + addGore + addNsfw + addCommercial + addMerch;

        // Calculate: Base * finish + Base * bg% + Base * addons%
        let finalPrice = basePrice * finishMultiplier;
        finalPrice += basePrice * bgMultiplier;
        finalPrice += basePrice * totalAddons;

        // Set hidden input (no visible display)
        document.getElementById('hiddenTotalPrice').value = finalPrice.toFixed(2);
    }

    // --- VISITOR COUNTER ---
    function fetchVisitorCount() {
        // Using a free API that tracks unique visits per browser session
        fetch('https://api.counterapi.dev/v1/eryn-portfolio/visits/up')
            .then(response => response.json())
            .then(data => {
                if (data && data.count) {
                    document.getElementById('visit-count').textContent = data.count;
                }
            })
            .catch(error => {
                console.log('Visitor counter unavailable:', error);
                document.getElementById('visit-count').textContent = 'N/A';
            });
    }

    // Initialize
    window.onload = function() {
        initSlideshow();
        updateHiddenTotal();
        fetchVisitorCount();
    };
</script>

